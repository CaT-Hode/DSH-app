{
  "name": "dsh-app",
  "version": "0.3.0",
  "description": "DSH desktop plugin for Windows: one Electron window, shared Web sessions and plugins, live startup logs and update recovery.",
  "type": "module",
  "main": "./lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-app": "./bin/dsh-app.mjs"
  },
  "files": [
    "bin/",
    "desktop/",
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "external": ["react", "react-dom"],
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "electron",
    "desktop",
    "windows"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CaT-Hode/DSH-app.git"
  },
  "homepage": "https://github.com/CaT-Hode/DSH-app#readme",
  "bugs": {
    "url": "https://github.com/CaT-Hode/DSH-app/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "optionalDependencies": {
    "electron": "44.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "^0.2.0-rc.2"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs && node scripts/build-preload.mjs",
    "test": "node --test tests/cost-meter.spec.mjs",
    "test:client": "node --test tests/client-ui.spec.mjs"
  },
  "dependencies": {
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "jsdom": "29.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
