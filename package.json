{
  "name": "dsh-app",
  "version": "0.2.0",
  "description": "DSH desktop plugin for Windows: one Electron window, shared Web sessions and plugins, live startup logs and update recovery.",
  "type": "module",
  "main": "./lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-app": "./bin/dsh-app.mjs"
  },
  "files": [
    "bin/",
    "desktop/",
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "electron",
    "desktop",
    "windows"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CaT-Hode/DSH-app.git"
  },
  "homepage": "https://github.com/CaT-Hode/DSH-app#readme",
  "bugs": {
    "url": "https://github.com/CaT-Hode/DSH-app/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "optionalDependencies": {
    "electron": "44.0.0"
  },
  "scripts": {
    "build": "node scripts/build-preload.mjs"
  },
  "dependencies": {
    "yaml": "2.8.1"
  }
}
